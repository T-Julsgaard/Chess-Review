{
  "manifest_version": 3,
  "name": "Chess Review",
  "version": "0.3.0",
  "description": "Free, open-source analysis for your chess games.",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab"
  ],
  "host_permissions": [
    "https://api.chess.com/*",
    "https://www.chess.com/*",
    "https://chess.com/*",
    "https://lichess.org/*"
  ],
  "action": {
    "default_title": "Chess Review — click to analyze this game",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module",
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{3824cf70-a9b3-4767-a9fa-d2b29af23116}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/icon.png"
      ],
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*",
        "https://lichess.org/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.chess.com/*",
        "https://chess.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content-button.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://lichess.org/*"
      ],
      "js": [
        "lichess-content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "analyze-current": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y"
      },
      "description": "Analyze the game I'm on"
    }
  }
}
