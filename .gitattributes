# Preserve official release checksums, including on Windows.
engine/stockfish*.js -text
engine/*.wasm binary
# Public evidence hashes must survive every platform's checkout settings.
tools/calibration/public/*.json text eol=lf
tools/calibration/public/*.gz binary
# Retained structured research evidence is hashed after LF normalization.
research/**/*.json text eol=lf
research/**/*.jsonl text eol=lf
research/**/*.csv text eol=lf
research/**/*.tsv text eol=lf
# Publisher evidence and policy receipts must survive checkout line endings.
research/datasets/evidence/*.md text eol=lf
research/DATA_POLICY.md text eol=lf
